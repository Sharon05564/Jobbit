# Copy this file to .env and fill in your values.
# The .env file is loaded automatically on startup.

# PostgreSQL connection string
DATABASE_URL=postgres://jobbit:jobbit@localhost:5432/jobbit

# HTTP server binding
HOST=0.0.0.0
PORT=3000

# Database connection pool size
DB_POOL_SIZE=5

# How often the worker checks for new jobs (milliseconds)
WORKER_POLL_INTERVAL_MS=2000

# Unique name for this worker instance (auto-generated from PID if omitted)
# WORKER_ID=worker-1
